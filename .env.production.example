# Reference only. Add required values in Vercel Project Settings > Environment Variables.
# Never commit real secrets or an actual .env file.

# Required for database-backed features, sign-in, comments, and user accounts
MONGODB_URI=
AUTH_SECRET=
AUTH_URL=https://ilmkhona0.com
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Optional social sign-in (set both values for a provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional, but required for persistent admin file uploads on Vercel
BLOB_READ_WRITE_TOKEN=

# Optional email and admin verification-code delivery
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_2FA_EMAIL=

# Optional AI features
GROQ_API_KEY=
GROQ_MODEL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=

# Optional Google ads and analytics; NEXT_PUBLIC values are embedded at build time
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=