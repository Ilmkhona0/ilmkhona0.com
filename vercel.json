{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Home/home.html",
      "use": "@vercel/node"
    },
    {
      "src": "Home/styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "General_link/(.*)",
      "use": "/@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Home/$1"
    },
    { 
      "src": "/General_link/(.*)",
      "dest": "/General_link/$1"
    }
  ]
}
