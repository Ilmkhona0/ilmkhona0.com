{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Home/home.html",
      "use": "@vercel/static"
    },
    {
      "src": "Home/styles.css",
      "use": "@vercel/static"
    },
    { 
      "src": "General_link/Circle_clock/clock_shape.html",
      "use": "@vercel/static"
    },
    {
      "src": "Home/Secret_Messages.html",
      "use": "@vercel/static"
   },
   {
     "src": "Home/GuessingGame/src/GuessingGame.exe,
     "use": "@vercel/static"
   }
    
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Home/home.html"
    },
    {
      "src": "/General_link/(.*)",
      "dest": "/General_link/$1"
    }
  ]
}
